PORT=3002
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deal_disaster
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-make-it-very-long-and-random

# Frontend URL for OAuth redirects
CLIENT_URL=http://localhost:5200
SERVER_URL=http://localhost:3002

# Investor Lab custom domain support
# Set INVESTOR_LAB_URL to the full public origin when serving Investor Lab on
# its own domain. Set VITE_INVESTOR_LAB_BASE_PATH=/ at build time so the
# frontend routes and assets are rooted at that domain.
# INVESTOR_LAB_URL=https://investor.yourdomain.com
# INVESTOR_LAB_DOMAIN=investor.yourdomain.com
# VITE_INVESTOR_LAB_BASE_PATH=/
# INVESTOR_LAB_JWT_SECRET=use-a-separate-strong-secret-in-production

# Google OAuth (Get from: https://console.cloud.google.com/apis/credentials)
# Add http://localhost:3002/api/auth/google/callback to Authorized redirect URIs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Geocoding + Places API (same console, enable Geocoding API & Places API)
# Used for property geocoding and MTR proximity scoring (hospitals, bases, universities, etc.)
GOOGLE_GEOCODING_API_KEY=your-google-api-key

# RapidAPI property data provider
# Ensure the subscribed plan has available credits for property lookups.
RAPIDAPI_KEY=your-rapidapi-key
RAPIDAPI_HOST=private-zillow.p.rapidapi.com

# Optional delay (ms, 0-10000, default 1000) before the single retry of a transient
# Zillow similar-properties failure.
# SIMILAR_PROPERTIES_RETRY_DELAY_MS=1000

# RentCast ZIP-market shared cache (optional; deploy schema with npm run db:setup first)
# Confirm your account's API data terms permit shared internal storage.
# false preserves the process-only seven-day cache; true enables PostgreSQL coordination.
RENTCAST_SHARED_MARKET_CACHE_ENABLED=false

# RentCast 24-hour shared rental-listings and AVM cache (deploy provider_data_cache schema first).
# Owner/property records are excluded; false retains process-only reuse.
RENTCAST_SHARED_PROPERTY_CACHE_ENABLED=false

# RentCast long-term rent mode. compatibility (default): active listings first, rent estimate
# only when no usable comps. bundle: one rent-estimate request supplies the estimate and comps
# seen within 180 days (including inactive ones); active listings are requested only when fewer
# than 3 plausible comps come back. Changes comp selection, so roll out deliberately.
RENTCAST_RENT_MODE=compatibility

# Persist sanitized provider request summaries for admin reporting (90-day retention).
# Deploy add_provider_usage_events.sql or run db:setup before enabling.
# Existing structured logs continue regardless of this flag.
PROVIDER_USAGE_REPORTING_ENABLED=false

# Property Analyzer usage limits & credits (Asset Dashboard only).
# off = no metering; shadow = record usage and log would-be blocks; enforce = return 402 when out of free runs/credits.
# Requires the analysis credit tables from `npm run db:setup`.
ANALYZER_METERING_MODE=off
ANALYZER_FREE_DAILY_LIMIT=5
ANALYZER_RUN_PRICE_CENTS=75
CREDIT_EXPIRY_MONTHS=12

# Optional cost-accounting scenario rate, not a billing guarantee.
# Foundation plan: $74/month for 1,000 requests (about $0.074 each), $0.06 per request over quota.
# RENTCAST_ESTIMATED_USD_PER_BILLABLE_REQUEST=0.074

# Microsoft OAuth (Get from: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps)
# Add http://localhost:3002/api/auth/microsoft/callback to Redirect URIs
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# Azure OpenAI (Get from: https://portal.azure.com)
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-5-nano

# OpenAI for DALL-E Image Generation
OPENAI_API_KEY=your-openai-api-key

# Azure Storage for Property Images (Get from: https://portal.azure.com)
# Connection string format: DefaultEndpointsProtocol=https;AccountName=youraccountname;AccountKey=yourkey;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONNECTION_STRING=your-azure-storage-connection-string
AZURE_STORAGE_CONTAINER_NAME=property-images

# Admin API Key for daily challenge generation (generate with: openssl rand -hex 32)
ADMIN_API_KEY=your-admin-api-key

# Email Configuration (SMTP)
# For development, leave these commented out to log emails to console instead
# For production, use a service like SendGrid, AWS SES, or Gmail/Google Workspace

# Option 1: Google Workspace (Custom Domain - e.g., support@moneymanmyers.com)
# Requires App Password with 2FA enabled on your Google Workspace account
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=support@moneymanmyers.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=support@moneymanmyers.com
# SMTP_REPLY_TO=support@moneymanmyers.com (optional, defaults to SMTP_FROM)

# Option 2: Gmail (Personal Account - Development)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=your-email@gmail.com

# Option 3: SendGrid (Recommended for Production)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key
# SMTP_FROM=noreply@yourdomain.com

# Option 3: AWS SES (Production)
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-aws-smtp-username
# SMTP_PASS=your-aws-smtp-password
# SMTP_FROM=noreply@yourdomain.com
